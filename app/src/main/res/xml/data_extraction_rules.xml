<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ equivalent of backup_rules.xml. Cloud backup and device-to-device
    transfer both exclude the intervention database for the same reason: it is a record
    of someone's private struggle with their own phone use.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="breathe.db" />
        <exclude domain="database" path="breathe.db-shm" />
        <exclude domain="database" path="breathe.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="breathe.db" />
        <exclude domain="database" path="breathe.db-shm" />
        <exclude domain="database" path="breathe.db-wal" />
    </device-transfer>
</data-extraction-rules>
