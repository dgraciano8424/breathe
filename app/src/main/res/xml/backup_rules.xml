<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup is disabled outright via android:allowBackup="false". These rules are a
    second line of defence for any path that might still be considered: the database
    records which apps a person struggles with, when they reached for them, and whether
    they gave in. That should not leave the device.
-->
<full-backup-content>
    <exclude domain="database" path="breathe.db" />
    <exclude domain="database" path="breathe.db-shm" />
    <exclude domain="database" path="breathe.db-wal" />
</full-backup-content>
